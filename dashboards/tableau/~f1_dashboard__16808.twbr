            <column-instance column='[Calculation_0395308282032131]' derivation='User' name='[usr:Calculation_0395308282032131:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
