    <worksheet name='Constructor Reliability Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Mechanical Failure Rate by Constructor (2019–2024)</run>
            <run>&#10;&lt;Sheet Name&gt;</run>
