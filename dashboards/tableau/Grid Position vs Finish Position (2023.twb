        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Constructor Finish Rate (2019–2024)</run>
            <run>&#10;&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='f1_main_extract' name='federated.1n2p4q403w5ynf1266lhp1tcm6wu' />
          </datasources>
          <datasource-dependencies datasource='federated.1n2p4q403w5ynf1266lhp1tcm6wu'>
            <column caption='Is Mechanical Failure' datatype='integer' name='[Calculation_0395308281712642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status_category] = &quot;Mechanical/Other&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Finish Rate' datatype='real' name='[Calculation_0395308285964292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([Calculation_0395308281712642]) / COUNT([result_id])' />
            </column>
            <column caption='Constructor Name' datatype='string' name='[constructor_name]' role='dimension' type='nominal' />
            <column-instance column='[constructor_name]' derivation='None' name='[none:constructor_name:nk]' pivot='key' type='nominal' />
