            <column caption='Status Category' datatype='string' name='[status_category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0395308285964292]' derivation='User' name='[usr:Calculation_0395308285964292:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.1n2p4q403w5ynf1266lhp1tcm6wu].[none:constructor_name:nk]' direction='DESC' using='[federated.1n2p4q403w5ynf1266lhp1tcm6wu].[usr:Calculation_0395308285964292:qk]' />
          <filter class='quantitative' column='[federated.1n2p4q403w5ynf1266lhp1tcm6wu].[none:year:qk]' included-values='in-range'>
