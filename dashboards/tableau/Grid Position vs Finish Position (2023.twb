      <aliases enabled='yes' />
      <column caption='Is Podium' datatype='integer' name='[Calculation_0395308276121600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [finish_position] &lt;= 3 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Is Win' datatype='integer' name='[Calculation_0395308276228097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [finish_position] = 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Is Mechanical Failure' datatype='integer' name='[Calculation_0395308281712642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status_category] = &quot;Mechanical/Other&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Mechanical Failure Rate' datatype='real' name='[Calculation_0395308282032131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0395308281712642]) / COUNT([result_id])' />
      </column>
      <column caption='Finish Rate' datatype='real' name='[Calculation_0395308285964292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([Calculation_0395308281712642]) / COUNT([result_id])' />
      </column>
      <column caption='Diagonal Reference' datatype='integer' name='[Calculation_1155071051747328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[grid]' />
      </column>
